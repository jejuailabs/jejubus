PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Google OAuth Web application. Never put the secret into public/.
# Put real local values in .env.local; it overrides .env on startup.
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TAGO: request access to Route / Stop / Arrival / Location APIs separately.
# Use the general Decoding key, not the already URL-encoded key.
TAGO_SERVICE_KEY=
TAGO_CITY_CODE=
TAGO_DAILY_LIMIT=1000
# Kakao: enable ONLY after verifying this app's free-quota badge and paid APIs OFF.
KAKAO_REST_KEY=
KAKAO_ENABLED=false
# ODsay is an optional alternative, never an automatic paid fallback.
# Verify Basic free plan and quota before enabling. App limit = 25/day.
ODSAY_API_KEY=
ODSAY_ENABLED=false
ODSAY_DAILY_LIMIT=25
SHOW_SAMPLE_POSTS=false
# Google subject IDs, comma separated; local /setup can add the signed-in operator.
ADMIN_GOOGLE_SUBS=
# AI inference is paid. Keep disabled until provider/model, budget and duration
# receive explicit informed approval. No default model or automatic paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ENABLED=false
AI_BILLING_APPROVED=false
AI_DAILY_LIMIT=10
# Firebase Admin is SERVER ONLY. Keep the JSON file outside the repository.
DATABASE_PROVIDER=sqlite
FIREBASE_PROJECT_ID=
FIREBASE_NAMESPACE=jejubus
FIREBASE_SERVICE_ACCOUNT_PATH=
# Vercel uses the JSON content as a sensitive environment variable instead of a local path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase web app configuration (not Admin credentials).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
