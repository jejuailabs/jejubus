PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Google OAuth Web application. Never put the secret into public/.
# Put real local values in .env.local; it overrides .env on startup.
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TAGO: request access to Route / Stop / Arrival / Location APIs separately.
# Use the general Decoding key, not the already URL-encoded key.
TAGO_SERVICE_KEY=
TAGO_CITY_CODE=
TAGO_DAILY_LIMIT=1000
# Kakao: enable ONLY after verifying this app's free-quota badge and paid APIs OFF.
KAKAO_REST_KEY=
KAKAO_ENABLED=false
# ODsay is an optional alternative, never an automatic paid fallback.
# Verify Basic free plan and quota before enabling. App limit = 25/day.
ODSAY_API_KEY=
ODSAY_ENABLED=false
ODSAY_DAILY_LIMIT=25
SHOW_SAMPLE_POSTS=false
# Google subject IDs, comma separated; local /setup can add the signed-in operator.
ADMIN_GOOGLE_SUBS=
# Only Google-verified email claims can grant owner access.
ADMIN_GOOGLE_EMAILS=
# AI inference is paid. Keep disabled until provider/model, budget and duration
# receive explicit informed approval. No default model or automatic paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ENABLED=false
AI_BILLING_APPROVED=false
AI_DAILY_LIMIT=20
# Each chat question uses at most 2 model calls. Shared cap for this approval period.
# Approval expires automatically. Never renew these without informed approval.
AI_PERIOD_CALL_LIMIT=100
AI_APPROVAL_ID=
AI_APPROVAL_UNTIL=
# Firebase Admin is SERVER ONLY. Keep the JSON file outside the repository.
DATABASE_PROVIDER=sqlite
# Set true only after explicit approval for this project's Blaze DB operations.
FIREBASE_BILLING_APPROVED=false
FIREBASE_PROJECT_ID=
FIREBASE_NAMESPACE=jejubus
FIREBASE_SERVICE_ACCOUNT_PATH=
# Vercel uses the JSON content as a sensitive environment variable instead of a local path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase web app configuration (not Admin credentials).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Driving experiment: enable only after verifying provider free quota / paid API disabled.
NAVIGATION_ENABLED=false
NAVIGATION_FREE_QUOTA_VERIFIED=false
NAVIGATION_DAILY_LIMIT=50

# Alternative: explicit bounded cost approval, no automatic renewal.
NAVIGATION_BILLING_APPROVED=false
NAVIGATION_APPROVAL_ID=
NAVIGATION_APPROVAL_UNTIL=
NAVIGATION_PERIOD_LIMIT=100
# 카카오 로그인·알림·상담. 기본 꺼짐. KAKAO_REST_KEY가 나온 앱에 설정한다.
# 로그인 전용 앱의 REST 키. 장소·길찾기용 KAKAO_REST_KEY와 분리한다.
KAKAO_LOGIN_REST_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_LOGIN_ENABLED=false
KAKAO_ALERT_ENABLED=false
# 채널 ID는 _로 시작하는 공개값이다.
KAKAO_CHANNEL_ID=
# 네이버 로그인(개발자센터)과 블로그 검색(NAVER API HUB)은 키가 다르다.
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
NAVER_LOGIN_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 요금·무료 한도를 확인한 뒤 켠다. 네이버 키가 없으면 카카오(다음) 블로그 검색을 쓴다.
BLOG_ENABLED=false
BLOG_DAILY_LIMIT=100
# 토스페이먼츠 테스트 키만 받는다(test_로 시작). live 키는 무시된다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 마이페이지 입금 안내 문구. 비우면 계좌 안내를 숨긴다.
PAY_ACCOUNT_TEXT=
