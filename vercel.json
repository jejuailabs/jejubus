{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": ["icn1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "web/public/**",
      "excludeFiles": "web/data/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {"source": "/", "destination": "/api/index?__jeju_path=/"},
    {"source": "/:path*", "destination": "/api/index?__jeju_path=/:path*"}
  ]
}
